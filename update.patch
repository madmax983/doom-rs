     /// Apply `amount` points of damage (positive = hurt).
     ///
-    /// Health is clamped to `[-32768, MAX_HEALTH]` after the operation.
-    /// Note: negative `amount` heals, but `heal()` is the preferred API.
+    /// # Edge Cases
+    /// Health is clamped to `[-32768, MAX_HEALTH]` after the operation to prevent integer
+    /// underflow from catastrophically reviving the player or breaking the HUD.
+    /// Note that passing a negative `amount` will heal the player, but [`PlayerState::heal`] is the preferred API for that.
+    ///
+    /// # Examples
+    /// ```
+    /// use doom_game::mobj::MobjHandle;
+    /// use doom_game::player::PlayerState;
+    ///
+    /// let mut player = PlayerState::pistol_start(MobjHandle::NULL);
+    /// player.apply_damage(20);
+    /// assert_eq!(player.health(), 80);
+    /// ```
     pub fn apply_damage(&mut self, amount: i32) {
         self.health = self.health.saturating_sub(amount).clamp(-32768, MAX_HEALTH);
     }

     /// Heal the player by `amount`, capped at `MAX_HEALTH`.
     ///
     /// Has no effect if the player is already at or above `MAX_HEALTH`.
+    ///
+    /// # Examples
+    /// ```
+    /// use doom_game::mobj::MobjHandle;
+    /// use doom_game::player::PlayerState;
+    ///
+    /// let mut player = PlayerState::pistol_start(MobjHandle::NULL);
+    /// player.apply_damage(50);
+    /// player.heal(20);
+    /// assert_eq!(player.health(), 70);
+    ///
+    /// // Healing stops at the natural cap (usually 100).
+    /// player.heal(500);
+    /// assert_eq!(player.health(), 100);
+    /// ```
     pub fn heal(&mut self, amount: i32) {
         if self.health < MAX_HEALTH {
             self.health = self.health.saturating_add(amount).min(MAX_HEALTH);
         }
     }

