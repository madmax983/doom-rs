     ///
     /// Used for power-up items (Soulsphere, Megasphere) that can overheal.
     /// Health is capped at `cap` (e.g. 200).
+    ///
+    /// # Examples
+    /// ```
+    /// use doom_game::mobj::MobjHandle;
+    /// use doom_game::player::PlayerState;
+    ///
+    /// let mut player = PlayerState::pistol_start(MobjHandle::NULL);
+    /// // A Soulsphere gives 100 health, up to a maximum of 200.
+    /// player.heal_overheal(100, 200);
+    /// assert_eq!(player.health(), 200);
+    /// ```
     pub fn heal_overheal(&mut self, amount: i32, cap: i32) {
         self.health = self.health.saturating_add(amount).min(cap);
     }

     /// Set health directly to `value`, clamped to `[0, cap]`.
     ///
-    /// Used for items that set health to a fixed value (e.g. Megasphere).
+    /// Why does this exist instead of `heal_overheal`? Some items in Doom (like the Megasphere)
+    /// don't add to your current health—they forcefully set it to a specific value regardless
+    /// of whether you are near death or already healthy.
+    ///
+    /// # Examples
+    /// ```
+    /// use doom_game::mobj::MobjHandle;
+    /// use doom_game::player::PlayerState;
+    ///
+    /// let mut player = PlayerState::pistol_start(MobjHandle::NULL);
+    /// // Picking up a Megasphere explicitly sets health to 200.
+    /// player.set_health_capped(200, 200);
+    /// assert_eq!(player.health(), 200);
+    /// ```
+    ///
+    /// # Panics
+    /// This function does not panic. The `value` is safely clamped to `[0, cap]`, and `cap` is
+    /// floored at `0` to prevent bounds logic inversion panics.
     pub fn set_health_capped(&mut self, value: i32, cap: i32) {
         self.health = value.clamp(0, cap.max(0));
     }
